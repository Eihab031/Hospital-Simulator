<Window x:Class="HospitalSim.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalSim.Wpf"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Hospital Simulation" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper }"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <TabControl>
        <TabItem Header="Patients">
            <TextBlock
                Text="phase 7: patient tab"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="Gray"
                FontWeight="Bold"/>
        </TabItem>
        <TabItem Header="Rooms &amp; Beds">
            <TextBlock
                Text="phase 8: Beds Tab"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="Gray"
                FontWeight="Bold"/>
        </TabItem>
        <TabItem Header="Simulation">
            <TextBlock
                Text="phase 9: Simulation Tab"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="Gray"
                FontWeight="Bold"/>
        </TabItem>
        <TabItem Header="Dashboard">
            <TextBlock
                Text="phase 10: Dashboard Tab"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="Gray"
                FontWeight="Bold"/>        
        </TabItem>
    </TabControl>
</Window>
